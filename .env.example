# Gemini server key; only used when ALLOW_SERVER_KEY=true.
GEMINI_API_KEY=
# GitHub token used by the server when a user does not provide their own.
GITHUB_TOKEN=
# Allow fallback to GEMINI_API_KEY; disabled by default.
ALLOW_SERVER_KEY=false
# Maximum server-key-backed Gemini requests per user per UTC day.
SERVER_KEY_DAILY_CAP=50
# 32-byte hexadecimal encryption key; required in production.
APP_ENCRYPTION_KEY=
# SQLite database location; stored under the ignored cache directory by default.
DATABASE_PATH=.codebase-tutor-cache/codebase-tutor.sqlite
# Comma-separated allowed browser origins; required in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Express listen port.
PORT=3000
# Runtime environment: development, test, or production.
NODE_ENV=development
# Maximum JSON request body size in bytes.
JSON_BODY_LIMIT_BYTES=2097152
# Maximum compressed GitHub archive size in bytes.
MAX_ARCHIVE_BYTES=26214400
# Maximum repository files parsed per analysis.
MAX_REPOSITORY_FILES=2500
# Maximum text file size analyzed in bytes.
MAX_TEXT_FILE_BYTES=358400
# Timeout for GitHub token verification calls in milliseconds.
GITHUB_AUTH_TIMEOUT_MS=10000
# Timeout for GitHub metadata and commit calls in milliseconds.
GITHUB_API_TIMEOUT_MS=15000
# Timeout for GitHub archive downloads in milliseconds.
GITHUB_ARCHIVE_TIMEOUT_MS=45000
# Internal flag set by the Express/Vite embedded server; normally leave unset.
EXPRESS_EMBEDDED=
# Disable Vite file watching and HMR when set to true.
DISABLE_HMR=false
